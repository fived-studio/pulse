{
  "name": "pulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FiveD Pulse — live engineering platform backend",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "bun test"
  },
  "dependencies": {
    "@octokit/auth-app": "^7.1.4",
    "@octokit/graphql": "^8.1.1",
    "@octokit/rest": "^21.0.2",
    "@octokit/webhooks": "^13.4.1",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.14",
    "ioredis": "^5.4.1",
    "postgres": "^3.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.7.2"
  }
}
