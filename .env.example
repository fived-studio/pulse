# Server
# Local dev uses 8787; Cloud Run injects PORT=8080 in production.
PORT=8787
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:8787

# Postgres
DATABASE_URL=postgres://pulse:pulse@localhost:5432/pulse

# Redis (Upstash or local)
REDIS_URL=redis://localhost:6379

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=         # paste full PEM with literal \n between lines
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Admin
ADMIN_PASSWORD=                 # for /admin/* basic auth

# Org config
FIVED_ORG=fived-studio

# LeetCode poller — refresh interval in minutes; 0 disables.
LEETCODE_POLL_INTERVAL_MIN=360
